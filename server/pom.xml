<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath /> <!-- lookup parent from repository -->
  </parent>
  <groupId>io.github.mucsi96</groupId>
  <artifactId>learnlanguage</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>learnlanguage</name>
  <description>Tools for language learning</description>
  <url />
  <licenses>
    <license />
  </licenses>
  <developers>
    <developer />
  </developers>
  <scm>
    <connection />
    <developerConnection />
    <tag />
    <url />
  </scm>
  <properties>
    <java.version>21</java.version>
    <!-- Spring profile baked into the AOT-processed / native image at build
         time. GraalVM native images resolve their bean definitions during AOT
         processing, so the profile cannot be chosen at runtime any more: build
         one image per profile instead (test, prod). -->
    <app.profile>prod</app.profile>
    <!-- C library the native executable links against. musl matches the
         Alpine runtime image in the Dockerfile; pass -Dnative.libc=glibc to
         compile on a regular Linux workstation for a local smoke test. -->
    <native.libc>musl</native.libc>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.azure.spring</groupId>
      <artifactId>spring-cloud-azure-starter-keyvault-secrets</artifactId>
      <exclusions>
          <exclusion>
              <groupId>com.azure</groupId>
              <artifactId>azure-core-http-netty</artifactId>
          </exclusion>
      </exclusions>
    </dependency>
    <!-- Use JDK HTTP client instead of Netty for Azure SDK (Netty 4.1 vs 4.2 incompatibility with Spring Boot 4) -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-core-http-jdk-httpclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.hypersistence</groupId>
      <artifactId>hypersistence-utils-hibernate-71</artifactId>
      <version>3.15.4</version>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.22.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java-client-okhttp</artifactId>
      <version>4.43.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-elevenlabs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-elevenlabs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-anthropic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-google-genai</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
      <version>5.0.0</version>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.azure.spring</groupId>
        <artifactId>spring-cloud-azure-dependencies</artifactId>
        <version>7.3.0</version> <!-- Spring Cloud Azure Support Status: https://github.com/Azure/azure-sdk-for-java/wiki/Spring-Versions-Mapping -->
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>2.0.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Ahead of the version the Azure BOM pins (1.58.0), whose
           native-image.properties forces SLF4J and logback to build-time
           initialization. Spring Boot sets logging up at run time, and the mix
           leaves objects of run-time initialized types in the image heap, which
           the native-image builder rejects. A build cannot undo such a
           directive either: exclude-config does not apply to
           native-image.properties, and initialize-at-run-time for the same
           class is rejected outright. 1.59.0 dropped those directives. Check
           this again when spring-cloud-azure-dependencies moves. -->
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-core</artifactId>
        <version>1.59.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>org.hibernate.orm</groupId>
              <artifactId>hibernate-processor</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>process-aot</id>
            <configuration>
              <profiles>
                <profile>${app.profile}</profile>
              </profiles>
              <!-- AOT processing refreshes the application context at build
                   time, so every placeholder an auto-configuration condition
                   reads has to resolve, and the Key Vault property source has
                   to be off so the build never reaches out to Azure. The
                   values below are build-time-only stand-ins: they are not
                   baked into the image, but the conditions they make match
                   are, so each has to make the same conditions match as the
                   real value does at runtime.
                   The actuator port decides whether the management endpoints
                   get a context of their own, which hinges on it differing
                   from the server port - not on either number. It never has to
                   equal the one test-pod.yaml or the Helm release sets; it only
                   has to stay different from the server port, as they are.
                   The mock OAuth2 issuer is read by Spring Security's
                   IssuerUriCondition in the test profile; only its presence
                   matters there, the JwtDecoder itself is built at runtime
                   from the real value.
                   A new required environment placeholder read by a condition
                   means adding it here too - the build fails with "Could not
                   resolve placeholder" when one is missing. Placeholders only
                   read while creating beans, such as ${db-url} or the AI API
                   keys, are resolved at runtime and do not belong here. -->
              <systemPropertyVariables>
                <spring.cloud.azure.keyvault.secret.property-source-enabled>false</spring.cloud.azure.keyvault.secret.property-source-enabled>
                <SPRING_ACTUATOR_PORT>8172</SPRING_ACTUATOR_PORT>
                <MOCK_OAUTH2_SERVER_URI>http://localhost:8079</MOCK_OAUTH2_SERVER_URI>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <configuration>
          <!-- Pull reachability metadata for libraries that do not ship their
               own (the PostgreSQL JDBC driver, ...). -->
          <metadataRepository>
            <enabled>true</enabled>
          </metadataRepository>
          <buildArgs>
            <!-- musl, to match the Alpine runtime image, and deliberately not
                 a fully static link: static binaries segfault the moment they
                 start in a container, before GraalVM installs its own segfault
                 handler and so with no output at all. Dynamic musl is what the
                 Liberica NIK musl image is built to produce. -->
            <buildArg>--libc=${native.libc}</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <!-- azure-core build-time initializes a few Jackson core classes
                 but not everything they hold on to, which would leave objects
                 of run-time initialized types in the image heap. Naming those
                 types one by one turns into whack-a-mole (Base64Variants pulls
                 in Base64Variant, which pulls in its nested
                 PaddingReadBehaviour), hence the whole package. -->
            <buildArg>--initialize-at-build-time=com.fasterxml.jackson.core</buildArg>
            <!-- See native-image.security for why the builder has to ignore
                 jar signatures. -->
            <buildArg>-J-Djava.security.properties=${project.basedir}/native-image.security</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
